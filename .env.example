# Five independent encrypted exit nodes: docker compose --profile exit-node up -d --build
# Set SHARE_HOST to the server's public IP or DNS name, NOT a Docker/container IP.
SHARE_HOST=
YANDEX_URL=
VYANDEX_URL=
BOARDS_URL=
MAILRU_URL=
# Cups rooms are created on first run and saved in its Docker volume.
DEBUG=0

# Optional single client / custom exit profiles:
TRANSPORT=yandex
DOC_URL=
MAX_TOKEN=
MAX_UID=
SOCKS5_LISTEN=:1080
EXIT_LOCAL_IP=
